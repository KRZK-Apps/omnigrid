{
    "name": "@omnigrid/selection-plugin",
    "version": "0.1.0",
    "description": "Headless row selection plugin for OmniGrid",
    "license": "MIT",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "npx tsc -p tsconfig.json",
        "lint": "npx tsc --noEmit -p tsconfig.json",
        "test": "vitest run",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@omnigrid/core": "0.1.0"
    }
}
