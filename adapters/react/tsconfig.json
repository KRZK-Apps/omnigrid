{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "baseUrl": ".",
        "paths": {
            "@omnigrid/core": ["../../core/dist/index.d.ts"]
        },
        "jsx": "react-jsx",
        "strict": true,
        "declaration": true,
        "outDir": "dist",
        "rootDir": "src",
        "noEmitOnError": true
    },
    "include": ["src"],
    "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
